{
  "Rules": [
    {
      "ID": "abort-incomplete-uploads",
      "Status": "Enabled",
      "Filter": {},
      "AbortIncompleteMultipartUpload": {
        "DaysAfterInitiation": 7
      }
    },
    {
      "ID": "cool-resumes-after-the-role-is-filled",
      "Status": "Enabled",
      "Filter": {
        "And": {
          "Prefix": "resumes/",
          "ObjectSizeGreaterThan": 131072
        }
      },
      "Transitions": [
        {
          "Days": 30,
          "StorageClass": "STANDARD_IA"
        }
      ]
    },
    {
      "ID": "delete-resumes-after-12-months",
      "Status": "Enabled",
      "Filter": {
        "Prefix": "resumes/"
      },
      "Expiration": {
        "Days": 365
      }
    }
  ]
}
