# Copy this file to `.env` and fill it in. `.env` is gitignored - never commit it.
#
#   cp .env.example .env
#
# Real environment variables override anything set here, so a hosting panel can
# supply values without editing files.

# --- Core ------------------------------------------------------------------
# Generate a fresh one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-me-with-a-generated-secret

# True only on your own machine. Never True on a public server.
DEBUG=True

# Comma separated. Required as soon as DEBUG is False.
ALLOWED_HOSTS=127.0.0.1,localhost

# Comma separated, scheme included. Needed behind HTTPS or a proxy.
# CSRF_TRUSTED_ORIGINS=https://rightwaysupportservices.com.au

# --- Database --------------------------------------------------------------
# MySQL:
DATABASE_URL=mysql://rightway:CHANGE_ME@127.0.0.1:3306/rightway
#
# Special characters in the password must be percent-encoded:
#   @ -> %40   : -> %3A   / -> %2F   # -> %23   ? -> %3F
#
# To go back to SQLite, comment the line above and use:
# DATABASE_URL=sqlite:///db.sqlite3

# Seconds to keep a database connection open between requests.
CONN_MAX_AGE=60

# --- Email -----------------------------------------------------------------
# Leave as-is to print emails to the terminal instead of sending them.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# To send for real through Amazon SES (production), switch the backend. It
# authenticates with the AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY pair from the
# S3 section below, so nothing else is needed as long as the sending domain is
# verified in the same region as the buckets. Docs/email.md has the checklist.
# EMAIL_BACKEND=config.ses_backend.SESEmailBackend
#
# Only if SES lives somewhere other than the buckets, or should use its own key:
# AWS_SES_REGION_NAME=ap-southeast-2
# AWS_SES_ACCESS_KEY_ID=
# AWS_SES_SECRET_ACCESS_KEY=
#
# Optional: an SES configuration set, for bounce/complaint/delivery events.
# AWS_SES_CONFIGURATION_SET=

# Or any SMTP server instead:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=

DEFAULT_FROM_EMAIL=no-reply@rightwaysupportservices.com.au

# Fallback only. The live address is editable in the dashboard under Settings.
CONTACT_EMAIL=arshdeep@rightwaysupportservices.com.au
CONSULTATION_PHONE=0470 522 587

# Who is notified about a submission is worked out from dashboard permissions:
# staff who can open an enquiry are told about enquiries, and so on. Nothing
# needs listing here. Use this only for an address with no staff account, such
# as a developer watching submissions. Comma separated.
ADMIN_NOTIFICATION_EMAILS=

# TESTING ONLY. With this set, every outgoing email goes here instead of to the
# real recipients, with the intended addresses written into the subject and
# body. The site still works out who would have received it, so the routing you
# are testing is the real thing. Leave empty in production.
# EMAIL_REDIRECT_TO=you@example.com

# --- File storage ----------------------------------------------------------
# Filesystem paths, used when USE_S3 is off. Absolute on a server; leave unset
# to use ./media and ./private-media.
# MEDIA_ROOT=/var/www/rightway/media
# PRIVATE_MEDIA_ROOT=/var/www/rightway/private-media

# --- Object storage (S3) ---------------------------------------------------
# Off by default: uploads go to the filesystem, which is what local development
# and the test suite want. Turn it on in production. Docs/s3-storage.md has the
# bucket setup, the IAM policy and the cutover steps.
USE_S3=False

# Two buckets, never one. Everything in the media bucket is world-readable by
# design; the private bucket holds resumes, which are personal information and
# must not be reachable by URL. Keeping them apart means no single policy edit
# can confuse the two.
# AWS_STORAGE_BUCKET_NAME=rightway-media
# AWS_PRIVATE_STORAGE_BUCKET_NAME=rightway-private

# Sydney: closest to the people using the site, and it keeps applicants'
# personal information onshore.
# AWS_S3_REGION_NAME=ap-southeast-2

# An IAM user scoped to those two buckets plus ses:SendEmail, and nothing
# else. Railway has no instance roles, so a key pair is the only option there.
# The SES backend above reuses this pair.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# A CloudFront distribution in front of the media bucket, once there is one.
# Leave empty to serve straight from S3. Transfer from S3 into CloudFront is
# free and CloudFront's first TB a month is too, so this is the cheaper option
# as soon as there is real traffic - but the site works fine without it.
# AWS_S3_CUSTOM_DOMAIN=cdn.rightwaysupportservices.com.au

# How long a resume download link stays valid, in seconds. It is minted after
# the permission check and only ever handed to the staff member who passed it.
# AWS_PRIVATE_URL_EXPIRY=300

# Sent with every uploaded image. Safe to cache forever because nothing is
# overwritten in place - a replacement upload gets a new name.
# AWS_MEDIA_CACHE_CONTROL=public, max-age=31536000, immutable

# --- HTTPS (production) ----------------------------------------------------
# Turn these on once TLS is terminating in front of the app.
#
# Required on any host that terminates TLS at its edge and forwards plain HTTP
# (Railway, Heroku, most load balancers). Without it, SECURE_SSL_REDIRECT sees
# an insecure request and redirects to itself forever. Only enable when a proxy
# really is in front - the app must not be reachable directly.
TRUST_PROXY_SSL_HEADER=False

SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
